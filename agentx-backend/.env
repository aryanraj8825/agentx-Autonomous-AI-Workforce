# --- core ---
APP_ENV=development                 # production enforces strong secrets and forbids the mock LLM
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SECRET_KEY=another-long-random-string   # encrypts integration credentials at rest
CORS_ORIGINS=http://localhost:5173

# --- models (leave GEMINI_API_KEY empty to use the offline mock LLM) ---
GEMINI_API_KEY=
MODEL_PRO=gemini-2.5-pro
MODEL_FLASH=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
TAVILY_API_KEY=                     # empty = mock search results

# --- storage (empty = in-memory, data lost on restart) ---
MONGO_URL=
MONGO_DB=agentx
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=

# --- execution ---
RUN_MODE=inline                     # inline (single API process) | celery (needs REDIS_URL + MONGO_URL)
RUNNER=auto                         # auto | langgraph | native
MAX_CONCURRENT_TASKS_PER_USER=3
NODE_TIMEOUT_S=300
MAX_REVISIONS=2
FILES_DIR=./data/files
MAX_UPLOAD_MB=15
MOCK_LLM_FLAWS=true                 # mock only: first draft has an uncited number so you can see the review loop
